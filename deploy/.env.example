# =============================================================================
# ORCA — LOCAL DEVELOPMENT VALUES ONLY.
#
# These are FIXTURES, not secrets. Every value in this file is committed to the
# repository, is identical on every developer's machine, and is worthless outside
# a laptop. Nothing here is ever used by a deployed installation: real credentials
# are supplied by the deployment, and a service that finds these values in a
# non-local profile should be treated as misconfigured.
#
#   cp .env.example .env && docker compose up -d
#
# `.env` is gitignored. `.env.example` is committed so that a clone, one copy and
# one command is the whole setup.
# =============================================================================

# --- SQL Server ---------------------------------------------------------------
# 8+ characters with upper, lower, digit and symbol. SQL Server exits at startup
# otherwise, and the message it prints does not say that.
MSSQL_SA_PASSWORD=Orca!Local2026
MSSQL_PORT=1433

# --- Keycloak -----------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080
KEYCLOAK_MANAGEMENT_PORT=9000

# --- Per-service database logins (ADR-004) ------------------------------------
# Each service authenticates as itself. Schema ownership is enforced by these
# credentials, not by convention: a service configured with a shared
# administrative login has no enforcement at all, and no build check can see it.
#
# deploy/bootstrap creates these logins and grants each one its own schema and
# nothing more. The services default to these same values in their own
# application.yaml, so a developer who has not exported anything still gets six
# distinct logins rather than six copies of `sa`.
ORCA_CORE_DB_PASSWORD=Orca!Core2026
ORCA_RUNTIME_DB_PASSWORD=Orca!Runtime2026
ORCA_EDGE_DB_PASSWORD=Orca!Edge2026
ORCA_PORTAL_DB_PASSWORD=Orca!Portal2026
ORCA_SYNC_DB_PASSWORD=Orca!Sync2026
ORCA_FLEET_DB_PASSWORD=Orca!Fleet2026

# --- Per-service Keycloak clients ---------------------------------------------
# One client per service, each with a service account, for service-to-service
# calls. These secrets are also written into deploy/keycloak/realm-export.json,
# because the realm is imported from that file rather than configured by hand.
ORCA_CORE_CLIENT_SECRET=local-dev-secret-orca-core
ORCA_RUNTIME_CLIENT_SECRET=local-dev-secret-orca-runtime
ORCA_EDGE_CLIENT_SECRET=local-dev-secret-orca-edge
ORCA_PORTAL_CLIENT_SECRET=local-dev-secret-orca-portal
ORCA_SYNC_CLIENT_SECRET=local-dev-secret-orca-sync
ORCA_FLEET_CLIENT_SECRET=local-dev-secret-orca-fleet
