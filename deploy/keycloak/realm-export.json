{
  "realm": "orca",
  "displayName": "ORCA",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "orca-service",
        "description": "Held by every service account. Marks a token as minted for a service, not a person."
      }
    ]
  },
  "clientScopes": [
    {
      "name": "orca-audience",
      "description": "Puts a stable audience on every service token so a resource server can check who a token was minted for.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "orca-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "orca",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "orca-core",
      "name": "orca-core",
      "description": "Service-to-service identity for orca-core. Confidential, service account only.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "secret": "local-dev-secret-orca-core",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "attributes": {
        "access.token.lifespan": "300",
        "use.refresh.tokens": "false"
      },
      "defaultClientScopes": [
        "basic",
        "acr",
        "roles",
        "web-origins",
        "profile",
        "email",
        "service_account",
        "orca-audience"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "orca-runtime",
      "name": "orca-runtime",
      "description": "Service-to-service identity for orca-runtime. Confidential, service account only.",
      "enabled": true,
